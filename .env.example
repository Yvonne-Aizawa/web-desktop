# Copy to `.env` and edit: `cp .env.example .env`
#
# The server reads these, and a value already set in your shell wins over this file.
# Nothing here is required; each line is a thing you might want to change.

# Where the shell listens. Keep it on loopback unless you mean to expose it.
#WEB_DESKTOP_ADDR=127.0.0.1:8080

# The one directory the file browser may touch. Defaults to ~/web-desktop, which the
# server creates. Point it at real work and it stays read-only until you say otherwise.
#WEB_DESKTOP_ROOT=~/Documents

# File editing: `on`/`off`. Default is on for the sandbox above, off for a root you
# chose with WEB_DESKTOP_ROOT.
#WEB_DESKTOP_FS_WRITE=on

# Paths inside the root that stay read-only even when the rest is writable, comma
# separated. Use this for anything inside the sandbox that must never be lost, e.g.
# a folder of your own work: the server refuses to write, rename or delete there.
#WEB_DESKTOP_FS_READONLY=Lumina

# Set to `off` to disable the file browser entirely.
#WEB_DESKTOP_FS=off

# Hosts the outbound proxy may reach, comma separated. Subdomains of a listed host
# are included. Unset means apps cannot fetch anything.
#WEB_DESKTOP_PROXY_HOSTS=pokeapi.co,api.example.com

# Also allow private and loopback addresses, for proxying to something of your own.
#WEB_DESKTOP_PROXY_ALLOW_PRIVATE=on

# An OpenAI-compatible chat provider, so an app can hold a conversation. Unset means
# the AI gateway is off, and the Chat app says so instead of failing. The key stays on
# the server: it is never logged and never sent to the browser, which is the reason the
# call is made here rather than by the app.
#WEB_DESKTOP_AI_URL=https://api.openai.com/v1
#WEB_DESKTOP_AI_KEY=sk-...

# The model a request gets when it names none.
#WEB_DESKTOP_AI_MODEL=gpt-4o-mini

# Models an app may ask for, comma separated. Defaults to just the one above. Anything
# outside the list is refused by the server, because a model is a bill.
#WEB_DESKTOP_AI_MODELS=gpt-4o-mini,gpt-4o

# Where the built app bundles live, and where the client bundle is served from.
#WEB_DESKTOP_APPS=apps
#WEB_DESKTOP_DIST=crates/client/dist

# Log level, e.g. `server=debug,tower_http=info`.
#RUST_LOG=server=debug
